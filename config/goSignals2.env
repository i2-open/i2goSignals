  # Used to configure GoSignals2 in docker and IDE
  MONGO_URL=mongodb://root:dockTest@mongo1:30001,mongo2:30002,mongo3:30003/?retryWrites=true&replicaSet=dbrs&readPreference=primary&serverSelectionTimeoutMS=5000&connectTimeoutMS=10000&authSource=admin&authMechanism=SCRAM-SHA-256
  I2SIG_STORE_MONGO_DBNAME=goSignals2
  PORT=8889
  BASE_URL=https://goSignals2:8889/
  I2SIG_AUTH_OAUTH_SERVERS=https://keycloak:9080/realms/gosignals/.well-known/openid-configuration

  # Authenticated bootstrap (PRD #120 / slice #121, generalized in #123): same
  # narrow "key" scope secret as goSignals1; the CLI client id for delegated OAuth.
  I2SIG_BOOTSTRAP_TOKEN=dev-bootstrap-secret
  I2SIG_CLI_CLIENT_ID=gosignals-cli

  KEYCLOAK_URL=https://keycloak:9080/realms/gosignals

  I2SIG_STORE_MONGO_RESUME_FILE=/app/resources/mongo_token_2.json

  LOG_LEVEL=INFO

  I2SIG_TLS_ENABLED=true
  I2SIG_TLS_CERT_PATH=/app/config/certs/server-cert.pem
  I2SIG_TLS_KEY_PATH=/app/config/certs/server-key.pem
  I2SIG_TLS_CA_CERT=/app/config/certs/ca-cert.pem

  # Ingest durability (write-ahead log). Left at the default here so goSignals2
  # acknowledges a SET only after a majority MongoDB write and serves as the
  # comparison node. Uncomment to acknowledge after an fsynced append to a
  # node-local WAL instead (lower ingest latency; SETs not yet drained are lost
  # with this node's disk). Ring-fed delivery is required when more than one
  # node runs in local mode. Only streams with durability=local use the WAL.
  # See goSignals1.env for the full description of each setting.
  #I2SIG_STORE_WAL=local
  #I2SIG_STORE_WAL_RING_FED=true
  #I2SIG_STORE_WAL_DIR=/app/bin/wal/goSignals2
  #I2SIG_STORE_WAL_DRAIN_TIMEOUT=20s
