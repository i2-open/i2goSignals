# Used to configure GoSignals1 in docker and IDE

MONGO_URL=mongodb://root:dockTest@mongo1:30001,mongo2:30002,mongo3:30003/?retryWrites=true&replicaSet=dbrs&readPreference=primary&serverSelectionTimeoutMS=5000&connectTimeoutMS=10000&authSource=admin&authMechanism=SCRAM-SHA-256
I2SIG_STORE_MONGO_DBNAME=goSignals1
PORT=8888
BASE_URL=https://goSignals1:8888/
I2SIG_AUTH_OAUTH_SERVERS=https://keycloak:9080/realms/gosignals/.well-known/openid-configuration

# Authenticated bootstrap (PRD #120 / slice #121, generalized in #123): the
# anonymous /iat door is closed. A bearer equal to I2SIG_BOOTSTRAP_TOKEN
# resolves to the narrow "key" scope so scimSsfSetup can mint an issuer key +
# IAT unattended. I2SIG_CLI_CLIENT_ID names the delegated-OAuth CLI client.
# This value must match the secret presented by scimSsfSetup / register*.sh.
I2SIG_BOOTSTRAP_TOKEN=dev-bootstrap-secret
I2SIG_CLI_CLIENT_ID=gosignals-cli

ADMIN_PORT=8899
ADMIN_UI_DIR=/Users/pjdhunt/git/i2goSignals/adminUI/build

# Used in demo adminUI
KEYCLOAK_URL=https://keycloak:9080/realms/gosignals

I2SIG_STORE_MONGO_RESUME_FILE=/app/resources/mongo_token_1.json

LOG_LEVEL=INFO

I2SIG_TLS_ENABLED=true
I2SIG_TLS_CERT_PATH=/app/config/certs/server-cert.pem
I2SIG_TLS_KEY_PATH=/app/config/certs/server-key.pem
I2SIG_TLS_CA_CERT=/app/config/certs/ca-cert.pem

I2SIG_ISSUER_DEFAULT=https://gosignals1:8888

# Ingest durability (write-ahead log). By default (I2SIG_STORE_WAL=majority)
# a SET is acknowledged to the transmitter only after MongoDB has written it
# to a majority of the replica set. Setting I2SIG_STORE_WAL=local acknowledges
# after an fsynced append to a WAL file on this node's disk; a background drain
# then moves entries into MongoDB. This lowers ingest latency and lifts
# throughput at the cost of node-local durability: SETs acknowledged but not
# yet drained are lost if this node's disk is lost, so keep the WAL directory
# on persistent storage that survives a container restart.
# I2SIG_STORE_WAL_RING_FED=true lets this node's push/poll/SSTP runners deliver
# straight from the WAL instead of waiting for the drain; it is required when
# more than one node runs in local mode (the server refuses to start otherwise).
# I2SIG_STORE_WAL_DRAIN_TIMEOUT bounds how long a graceful stop waits for the
# drain; keep it below the orchestrator's termination grace period.
# `local` is a ceiling, not a switch: only streams created or updated with
# durability=local use the WAL; every other stream keeps the majority contract.
# goSignals2 keeps the defaults so the two nodes can be compared.
I2SIG_STORE_WAL=local
I2SIG_STORE_WAL_RING_FED=true
I2SIG_STORE_WAL_DIR=/app/bin/wal/goSignals1
I2SIG_STORE_WAL_DRAIN_TIMEOUT=20s
